{
  "name": "rain-campus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "postinstall": "node node_modules/electron/install.js",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop-packaged": "node tests/desktop.mjs --packaged"
  },
  "dependencies": {
    "phaser": "4.0.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "playwright": "1.64.1",
    "typescript": "~5.7.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
